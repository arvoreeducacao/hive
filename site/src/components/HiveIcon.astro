---
const { name, size = 18 } = Astro.props

const icons = {
  term: `<rect x="1.8" y="2.6" width="12.4" height="10.8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.4 6.2 6.6 8l-2.2 1.8M8.2 10.2h3.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>`,
  phone: `<rect x="4.2" y="1.4" width="7.6" height="13.2" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M6.9 12.4h2.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>`,
  lock: `<rect x="3.2" y="6.9" width="9.6" height="7.2" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M5.6 6.9V5.2a2.4 2.4 0 0 1 4.8 0v1.7" fill="none" stroke="currentColor" stroke-width="1.2"/>`,
  globe: `<circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M1.9 8h12.2M8 1.8c1.9 1.9 2.9 3.9 2.9 6.2S9.9 12.3 8 14.2C6.1 12.3 5.1 10.3 5.1 8s1-4.3 2.9-6.2Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>`,
  agent: `<path d="M8 1.9 13.4 5v6L8 14.1 2.6 11V5Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.9" fill="currentColor"/>`,
  grid: `<rect x="2.2" y="2.2" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="8.8" y="2.2" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2.2" y="8.8" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="8.8" y="8.8" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/>`,
  keys: `<rect x="1.6" y="4" width="12.8" height="8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.2 6.6h.01M6.8 6.6h.01M9.4 6.6h.01M12 6.6h.01M5.2 9.4h5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`,
  plug: `<path d="M6 1.7v3.4M10 1.7v3.4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M4.1 5.1h7.8v2.3A3.9 3.9 0 0 1 8 11.3a3.9 3.9 0 0 1-3.9-3.9Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M8 11.3v3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>`,
}
---

<svg
  viewBox="0 0 16 16"
  width={size}
  height={size}
  aria-hidden="true"
  set:html={icons[name]}
/>
